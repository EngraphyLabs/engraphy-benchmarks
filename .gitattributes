# LF in every checkout, on every platform. Results, configs and answer files are
# compared by sha256, and a checkout that rewrote line endings would make
# byte-identical content hash differently.
* text=auto eol=lf
*.png binary

# Committed result files are hashed in their manifests; keep their bytes identical on every checkout.
results/**/*.jsonl -text
results/**/validity_controls.py -text
results/**/*.manifest.json -text
